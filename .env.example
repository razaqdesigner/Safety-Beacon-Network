# Local (non-Replit) development only — copy to `.env` and adjust.
# Every value is optional; `pnpm local` falls back to the defaults shown.
# On Replit these are injected by the platform and this file is ignored.

# Defaults to the embedded Postgres started by `pnpm local` / `pnpm local:db`.
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/safealert

# LOCAL_PG_PORT=5433
# LOCAL_API_PORT=8080
# LOCAL_ADMIN_PORT=23744

# Where the Expo app reaches the API. Defaults to http://<your LAN IP>:8080 so
# a phone running Expo Go on the same Wi-Fi can connect.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
